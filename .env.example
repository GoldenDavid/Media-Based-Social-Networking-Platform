# ── Backend profile selection ──────────────────────────────────────────────
# `local`  = run services on the host (gradlew, IDE)
# `docker-compose` = run inside `docker compose up` (overrides hosts to service names)
SPRING_PROFILES_ACTIVE=local

# ── MySQL ──────────────────────────────────────────────────────────────────
# Defaults below match what docker-compose.yml uses if no .env is present.
# Every service reads MYSQL_DATABASE via its compose env block and joins it
# with `mysql:3306`; locally each service uses its own DB by name.
MYSQL_ROOT_PASSWORD=app
MYSQL_USER=app
MYSQL_PASSWORD=app
MYSQL_DATABASE=social_network

# ── Redis ──────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=devpassword

# ── RabbitMQ ───────────────────────────────────────────────────────────────
# The app ymls use RABBITMQ_USER / RABBITMQ_PASSWORD (NOT the official
# RABBITMQ_DEFAULT_USER/PASS env vars), so the names below are what the
# services actually look up.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ── MinIO / object storage ─────────────────────────────────────────────────
# These values are read by `docker-compose.yml` AND by media-service's
# application.yml (via MINIO_ACCESS_KEY / MINIO_SECRET_KEY). Keep them
# in sync with the defaults below.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=spring-boot
# Used by the monolith only (local dev):
MINIO_ENDPOINT=http://localhost:9000

# ── Google OAuth2 (set these for social login) ─────────────────────────────
# In production these come from Google Cloud Console. Leave blank in dev
# to disable real Google login; the monolith falls back to a mock user
# (`alex_cyber`) when these are missing.
GOOGLE_CLIENT_ID=CHANGE_YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=CHANGE_YOUR_GOOGLE_SECRET_CLIENT_ID

# ── Frontend (NOT consumed by the backend; documented here for completeness) ─
# VITE_MEDIA_BASE_URL=http://localhost:9000/spring-boot
# VITE_API_BASE_URL=/api
